{
  "name": "pagni-medical-tests-aggregator",
  "version": "2.0.0-alpha.0",
  "description": "Privacy-first desktop app that aggregates PAGNI blood-test PDF reports and visualizes results over time",
  "author": "gtopsis",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint",
    "lint-and-fix": "eslint --fix"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-store": "^2.4.1",
    "chart.js": "^4.5.1",
    "pinia": "^3.0.4",
    "ulid": "^3.0.1",
    "vue": "^3.5.42",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.9.5",
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  }
}
